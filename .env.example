# Copy this file to .env and fill in real values. Never commit .env.

# --- Database ---
DATABASE_URL=postgresql+asyncpg://shopygenie:shopygenie@localhost:5433/shopygenie

# --- JWT ---
JWT_SECRET_KEY=change-me-to-a-long-random-value
JWT_ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=30
REFRESH_TOKEN_EXPIRE_DAYS=14

# --- CORS ---
# Comma-separated list of allowed origins. No "*" in production.
CORS_ORIGINS=http://localhost:4200

# --- Platform owner seed account (used only by scripts/seed.py) ---
PLATFORM_OWNER_EMAIL=johnwillymarandu@gmail.com
PLATFORM_OWNER_PASSWORD=change-me
PLATFORM_OWNER_NAME=John Willy Marandu

# --- SMS provider (SMSGate) — wired as a stub adapter for now ---
SMSGATE_BASE_URL=
SMSGATE_API_KEY=
SMSGATE_SENDER_ID=

# --- File uploads (expense evidence) ---
UPLOADS_DIR=uploads
MAX_UPLOAD_BYTES=5242880

# --- Environment ---
ENVIRONMENT=development
