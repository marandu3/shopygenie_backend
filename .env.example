# Copy this file to .env and fill in real values. Never commit .env.

# --- Database ---
DATABASE_URL=postgresql+asyncpg://shopygenie:shopygenie@localhost:5433/shopygenie

# --- JWT ---
JWT_SECRET_KEY=change-me-to-a-long-random-value
JWT_ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=30
REFRESH_TOKEN_EXPIRE_DAYS=14

# --- CORS ---
# Comma-separated list of allowed origins. No "*" in production.
CORS_ORIGINS=http://localhost:4200

# --- Platform owner seed account (used only by scripts/seed.py) ---
PLATFORM_OWNER_EMAIL=johnwillymarandu@gmail.com
PLATFORM_OWNER_PASSWORD=change-me
PLATFORM_OWNER_NAME=John Willy Marandu

# --- SMS provider (SMSGate, sms-gate.app) — local-dev/seed convenience
# only; the live app reads per-tenant config from Settings > Notifications,
# never these. When set, `python -m scripts.seed` applies them to the demo
# tenant so SMS works immediately without configuring it via the UI first.
# SMSGate authenticates with HTTP Basic (username/password) and targets a
# specific registered Android device by device_id.
SMSGATE_BASE_URL=https://api.sms-gate.app/3rdparty/v1
SMSGATE_USERNAME=
SMSGATE_PASSWORD=
SMSGATE_DEVICE_ID=

# --- File uploads (expense evidence) ---
UPLOADS_DIR=uploads
MAX_UPLOAD_BYTES=5242880

# --- Environment ---
ENVIRONMENT=development
